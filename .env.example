# Скопируйте этот файл в .env и при необходимости измените значения.
# Без .env проект тоже запускается: используется SQLite (файл phishdet.db)
# а оплата не работает, пока не заданы ключи ЮKassa.

# База данных. По умолчанию — локальный SQLite, ничего указывать не обязательно.
# DATABASE_URL=sqlite+aiosqlite:///./phishdet.db
# Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/phishdet

# Секрет для подписи JWT-токенов (в продакшене замените на случайные 32+ символа).
SECRET_KEY=dev-secret-key-change-me

# ЮKassa: личный кабинет → Интеграция → Ключи API.
# Тестовый магазин создаётся сразу после регистрации, его ключ начинается с test_.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек по 54-ФЗ: 1 - отправлять (нужны подключённые «Чеки от ЮKassa» или своя касса), 0 - нет.
YOOKASSA_SEND_RECEIPT=1
# Ставка НДС в чеке: 1 - без НДС, остальные коды - https://yookassa.ru/developers/payment-acceptance/receipts/54fz/other-services/parameters-values#vat-codes
# Какая нужна вашему ООО - уточните у бухгалтера.
YOOKASSA_VAT_CODE=1

# Адрес сайта: из него собираются ссылки в письмах и адреса возврата с оплаты.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Почта (подтверждение адреса и сброс пароля). Без SMTP_HOST письма печатаются в консоль сервера.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURITY=ssl            # ssl (порт 465) | starttls (порт 587) | none
# SMTP_USER=no-reply@phishdet.ru
# SMTP_PASSWORD=
# SMTP_FROM=PhishDet <no-reply@phishdet.ru>

# За обратным прокси (nginx) - брать IP клиента из X-Forwarded-For для лимитов запросов.
# TRUST_PROXY=1
