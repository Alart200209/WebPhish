+/* ===================================
+   КУРСОР-ПРОЖЕКТОР (spotlight)
+   Тёплый свет следует за мышью по секциям и карточкам
+=================================== */
+body.has-spotlight {
+    position: relative;
+}
+
+body.has-spotlight::before {
+    content: '';
+    position: fixed;
+    inset: 0;
+    z-index: 0;
+    pointer-events: none;
+    background: radial-gradient(
+        420px circle at var(--mouse-x, 50%) var(--mouse-y, 0%),
+        rgba(245, 165, 36, 0.06),
+        transparent 65%
+    );
+    transition: opacity 0.4s ease;
+}
+
+/* Прожектор внутри карточек — подсвечивает ту, на которой мышь */
+.card-spotlight {
+    position: relative;
+    isolation: isolate;
+}
+
+.card-spotlight::after {
+    content: '';
+    position: absolute;
+    inset: -1px;
+    border-radius: inherit;
+    z-index: -1;
+    pointer-events: none;
+    opacity: 0;
+    background: radial-gradient(
+        260px circle at var(--card-mouse-x, 50%) var(--card-mouse-y, 50%),
+        rgba(245, 165, 36, 0.18),
+        transparent 70%
+    );
+    transition: opacity 0.35s ease;
+}
+
+.card-spotlight:hover::after,
+.card-spotlight.is-lit::after {
+    opacity: 1;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    body.has-spotlight::before,
+    .card-spotlight::after {
+        display: none;
+    }
+    html { scroll-behavior: auto; }
+    *, *::before, *::after {
+        animation-duration: 0.01ms !important;
+        transition-duration: 0.01ms !important;
+    }
+}
+
 /* ===================================
    RESPONSIVE
 =================================== */
